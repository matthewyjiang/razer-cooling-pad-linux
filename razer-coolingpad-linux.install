post_install() {
  cat <<'EOF'
==> To enable the packaged systemd service, run:
    sudo systemctl enable --now razer-coolingpad.service

==> Default config:
    /etc/razer-coolingpad-linux/config.json

==> Example curves:
    /usr/share/razer-coolingpad-linux/curves/
EOF
}

post_upgrade() {
  post_install
}
